---
import { localizedPaths, ui, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  alternateNl: string;
  alternateEn: string;
}

const { lang, alternateNl, alternateEn } = Astro.props;
const labels = ui[lang];
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href={localizedPaths.home[lang]}>{labels.brand}</a>
    <nav aria-label={lang === "nl" ? "Hoofdnavigatie" : "Main navigation"}>
      <a href={localizedPaths.articles[lang]}>{labels.navEducation}</a>
      <a href={localizedPaths.about[lang]}>{labels.navAbout}</a>
      <a class="consultation-link" href="mailto:alexfu.dr@yahoo.com">{labels.consultation}</a>
    </nav>
    <div class="language-switch" aria-label={labels.languageLabel}>
      <a href={alternateNl} hreflang="nl" lang="nl" aria-current={lang === "nl" ? "page" : undefined}>NL</a>
      <span aria-hidden="true">/</span>
      <a href={alternateEn} hreflang="en" lang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a>
    </div>
  </div>
</header>
