---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  lang="en"
  title="Acupuncture, clearly explained | Alex Fu"
  description="Reliable, accessible information about acupuncture research, safety, and uncertainty."
  canonicalPath="/en/"
  alternateNl="/nl/"
  alternateEn="/en/"
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Evidence · context · care</p>
      <h1>Understand acupuncture without exaggerated promises</h1>
      <p class="lead">We translate research into clear explanations: what do we know, what remains uncertain, and what could it mean in practice?</p>
      <div class="hero-actions">
        <a class="button primary" href="/en/articles/">Explore the education</a>
        <a class="button secondary" href="/en/about/">About the author</a>
      </div>
    </div>
    <aside class="evidence-card" aria-label="Our approach">
      <p class="card-kicker">Our approach</p>
      <h2>Evidence before conviction</h2>
      <ul>
        <li>Sources are verifiable</li>
        <li>Uncertainty stays visible</li>
        <li>Safety belongs in every topic</li>
      </ul>
    </aside>
  </section>
  <section class="principles shell" aria-labelledby="principles-title">
    <div>
      <p class="eyebrow">Why this website exists</p>
      <h2 id="principles-title">Education comes first</h2>
    </div>
    <p>This website helps readers assess acupuncture claims critically. Consultation is available as a modest external entry point, not as the purpose of the content.</p>
  </section>
</BaseLayout>
