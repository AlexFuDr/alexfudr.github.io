---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const articles = (await getCollection("articles", ({ data }) => data.lang === "nl" && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout lang="nl" title="Educatie over acupunctuur | Alex Fu" description="Wetenschappelijk onderbouwde uitleg over acupunctuur." canonicalPath="/nl/artikelen/" alternateNl="/nl/artikelen/" alternateEn="/en/articles/">
  <section class="listing shell">
    <p class="eyebrow">Educatie</p>
    <h1>Onderzoek begrijpelijk gemaakt</h1>
    <p class="lead">Artikelen over bewijs, veiligheid en de grenzen van wat we weten.</p>
    <div class="article-list">
      {articles.map((article) => (
        <a class="article-preview" href={`/nl/artikelen/${article.data.slug}/`}>
          <span>{article.data.content_type}</span>
          <h2>{article.data.title}</h2>
          <p>{article.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
