---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.lang === "nl" && !data.draft);
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

interface Props { article: CollectionEntry<"articles"> }
const { article } = Astro.props;
const { Content } = await render(article);
const path = `/nl/artikelen/${article.data.slug}/`;
---

<ArticleLayout
  lang="nl"
  title={article.data.title}
  description={article.data.description}
  canonicalPath={path}
  alternateNl={path}
  alternateEn={article.data.alternate_path}
  author={article.data.author}
  published={article.data.date}
  reviewed={article.data.last_reviewed}
  certainty={article.data.evidence_certainty}
  conflicts={article.data.conflicts}
>
  <Content />
</ArticleLayout>
